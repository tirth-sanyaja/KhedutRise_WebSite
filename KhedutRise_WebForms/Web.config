<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="KhedutRiseDB" 
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=KhedutRiseDB;Integrated Security=True;Connect Timeout=30" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    
    <!-- SMS Gateway Configuration (Supported: Fast2SMS, MSG91, Simulated) -->
    <add key="SmsProvider" value="Fast2SMS" />
    <add key="SmsApiKey" value="YOUR_SMS_GATEWAY_API_KEY_HERE" />
    <add key="SmsSenderId" value="KHDRSE" />
    <!-- When true and SmsApiKey is a placeholder, logs delivery and enables local dev testing -->
    <add key="SmsSimulateInDev" value="true" />
    
    <!-- OTP Security Policy -->
    <add key="OtpLength" value="6" />
    <add key="OtpExpiryMinutes" value="5" />
    <add key="OtpResendCooldownSeconds" value="60" />
    <add key="OtpMaxAttempts" value="5" />
    
    <!-- Administrator Registered Mobile Number for SMS OTP verification -->
    <add key="AdminMobileNumber" value="9876500001" />
  </appSettings>
  <system.web>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
