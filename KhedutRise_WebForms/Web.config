<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="KhedutRiseDB" 
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=KhedutRiseDB;Integrated Security=True;Connect Timeout=30" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    
    <!-- OTP Security Policy -->
    <add key="OtpLength" value="6" />
    <add key="OtpExpiryMinutes" value="5" />
    <add key="OtpResendCooldownSeconds" value="60" />
    <add key="OtpMaxAttempts" value="5" />

    <!-- ═══ SMTP Email Configuration (Gmail App Password) ═══════════════════
         HOW TO SET UP GMAIL SMTP:
         1. Go to your Google Account → Security → 2-Step Verification → Enable it
         2. Then go to Security → App Passwords
         3. Select App = "Mail", Device = "Other" → type "KhedutRise" → Generate
         4. Copy the 16-character App Password shown (e.g. "abcd efgh ijkl mnop")
         5. Paste it (without spaces) in SmtpPassword below.
         6. Set SmtpUser to your Gmail address (e.g. khedutrise@gmail.com)
         7. Set SmtpFrom to: KhedutRise <khedutrise@gmail.com>
         ════════════════════════════════════════════════════════════════════ -->
    <add key="SmtpHost"      value="smtp.gmail.com" />
    <add key="SmtpPort"      value="587" />
    <add key="SmtpUser"      value="YOUR_GMAIL@gmail.com" />
    <add key="SmtpPassword"  value="YOUR_APP_PASSWORD_HERE" />
    <add key="SmtpFrom"      value="KhedutRise &lt;YOUR_GMAIL@gmail.com&gt;" />
    <add key="SmtpEnableSsl" value="true" />
  </appSettings>
  <system.web>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
